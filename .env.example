# Настройки подключения к Supabase (получите в Project Settings -> API на supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Адрес личного кабинета (на Vercel или собственный поддомен)
NEXT_PUBLIC_LK_URL=https://lk-ayda-umnichka.vercel.app
